# Market data provider: india | public | demo | fyers | upstox | angel
MARKET_DATA_PROVIDER=india

# JWT signing secret — CHANGE THIS in production (use: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Environment: development | production
# In production the app refuses to start if JWT_SECRET is the default value.
ENVIRONMENT=development

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seeded admin account (applied on first boot only)
ADMIN_EMAIL=admin@stockapp.com
ADMIN_NAME=Admin User
ADMIN_PASSWORD=admin123

# API settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000

# Broker credentials (only needed for fyers/upstox/angel modes)
FYERS_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_ACCESS_TOKEN=
ANGEL_API_KEY=
