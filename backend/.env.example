# Market data provider: india | public | demo | fyers | upstox | angel
MARKET_DATA_PROVIDER=india

# JWT signing secret — CHANGE THIS in production (use a long random string)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# API settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Broker credentials (only needed for fyers/upstox/angel modes)
FYERS_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_ACCESS_TOKEN=
ANGEL_API_KEY=
